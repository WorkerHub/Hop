{
  "name": "@hop/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "generate:migrations": "node --import tsx scripts/generate-migrations.ts",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "jose": "^6.0.0",
    "otpauth": "^9.3.6",
    "@simplewebauthn/server": "^13.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}

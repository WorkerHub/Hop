# Local development variables and secrets.
# Copy this file to apps/worker/.dev.vars and fill in real values.
# .dev.vars is gitignored — never commit real secrets.

# ─── Ordinary variables (all optional) ────────────────────────────────────────
# Leave these empty to derive them from the request URL: APP_URL/APP_ORIGIN from
# the request origin, RP_ID from the request hostname. An explicit value always
# wins. APP_NAME is gone — the app name is the admin UI setting `app_name`
# (default "Hop").
#
# APP_ORIGIN is only needed for passkey testing locally: the page is served by
# the Vite dev server (http://localhost:5173) while /api is proxied to :8787.
APP_URL=
RP_ID=
APP_ORIGIN=

# ─── Runtime secrets ──────────────────────────────────────────────────────────
# Production values live in Cloudflare Secrets (uploaded from GitHub Secrets by
# the deploy workflow). Generate your own local values; do not reuse production
# values.
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
SETUP_SECRET=

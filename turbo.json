{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "TABLE_PREFIX",
    "WAKER_MODE",
    "WAKER_URL",
    "WAKER_TRIGGERS",
    "WRANGLER_TOML",
    "GITHUB_OUTPUT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["@hop/web#build", "build"],
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN"]
    }
  }
}
